        <mxCell id="session" value="&lt;p style=&quot;margin:6px 0 4px 0;text-align:center;&quot;&gt;&lt;b&gt;AgentSession&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:8px 10px;font-size:11px;line-height:1.45;&quot;&gt;+ agent: Agent&lt;br/&gt;+ sessionManager: SessionManager&lt;br/&gt;+ settingsManager: SettingsManager&lt;br/&gt;+ extensionRunner: ExtensionRunner&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:8px 10px;font-size:11px;line-height:1.45;&quot;&gt;+ prompt(...)&lt;br/&gt;+ abort(): Promise&amp;lt;void&amp;gt;&lt;br/&gt;+ dispose(): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
