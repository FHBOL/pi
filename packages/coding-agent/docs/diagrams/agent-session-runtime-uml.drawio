          <mxGeometry x="40" y="20" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="单槽持有当前 session + services；替换时覆盖槽，不 new 自身" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="520" height="20" as="geometry" />
        </mxCell>

        <mxCell id="factory" value="&lt;p style=&quot;margin:6px 0 4px 0;text-align:center;&quot;&gt;&lt;i&gt;&amp;laquo;type&amp;raquo;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;CreateAgentSessionRuntimeFactory&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:8px 10px;font-size:11px;line-height:1.45;&quot;&gt;(options: {&lt;br/&gt;&amp;nbsp;&amp;nbsp;cwd: string&lt;br/&gt;&amp;nbsp;&amp;nbsp;agentDir: string&lt;br/&gt;&amp;nbsp;&amp;nbsp;sessionManager: SessionManager&lt;br/&gt;&amp;nbsp;&amp;nbsp;sessionStartEvent?: SessionStartEvent&lt;br/&gt;&amp;nbsp;&amp;nbsp;projectTrustContext?: ProjectTrustContext&lt;br/&gt;}) → Promise&amp;lt;CreateAgentSessionRuntimeResult&amp;gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="400" height="230" as="geometry" />
        </mxCell>

        <mxCell id="runtime" value="&lt;p style=&quot;margin:8px 0 6px 0;text-align:center;&quot;&gt;&lt;b&gt;AgentSessionRuntime&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:6px 10px;font-size:11px;line-height:1.5;&quot;&gt;- rebindSession?: (session) → Promise&amp;lt;void&amp;gt;&lt;br/&gt;- beforeSessionInvalidate?: () → void&lt;br/&gt;- _session: AgentSession&lt;br/&gt;- _services: AgentSessionServices&lt;br/&gt;- createRuntime: CreateAgentSessionRuntimeFactory&lt;br/&gt;- _diagnostics: Diagnostic[]&lt;br/&gt;- _modelFallbackMessage?: string&lt;br/&gt;+ session: AgentSession&amp;nbsp;&amp;nbsp;{readonly}&lt;br/&gt;+ services: AgentSessionServices&amp;nbsp;&amp;nbsp;{readonly}&lt;br/&gt;+ cwd: string&amp;nbsp;&amp;nbsp;{readonly}&lt;br/&gt;+ diagnostics: readonly Diagnostic[]&amp;nbsp;&amp;nbsp;{readonly}&lt;br/&gt;+ modelFallbackMessage?: string&amp;nbsp;&amp;nbsp;{readonly}&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:6px 10px;font-size:11px;line-height:1.5;&quot;&gt;+ constructor(session, services, factory, diagnostics?, fallback?)&lt;br/&gt;+ setRebindSession(cb?): void&lt;br/&gt;+ setBeforeSessionInvalidate(cb?): void&lt;br/&gt;+ switchSession(path, options?): Promise&amp;lt;{cancelled}&amp;gt;&lt;br/&gt;+ newSession(options?): Promise&amp;lt;{cancelled}&amp;gt;&lt;br/&gt;+ fork(entryId, options?): Promise&amp;lt;{cancelled, selectedText?}&amp;gt;&lt;br/&gt;+ importFromJsonl(path, cwdOverride?): Promise&amp;lt;{cancelled}&amp;gt;&lt;br/&gt;+ dispose(): Promise&amp;lt;void&amp;gt;&lt;br/&gt;- emitBeforeSwitch(reason, target?): Promise&amp;lt;{cancelled}&amp;gt;&lt;br/&gt;- emitBeforeFork(entryId, options): Promise&amp;lt;{cancelled}&amp;gt;&lt;br/&gt;- teardownCurrent(reason, target?): Promise&amp;lt;void&amp;gt;&lt;br/&gt;- apply(result): void&lt;br/&gt;- finishSessionReplacement(withSession?): Promise&amp;lt;void&amp;gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="540" y="90" width="540" height="700" as="geometry" />
        </mxCell>

        <mxCell id="result" value="&lt;p style=&quot;margin:6px 0 4px 0;text-align:center;&quot;&gt;&lt;i&gt;&amp;laquo;interface&amp;raquo;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;CreateAgentSessionRuntimeResult&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:8px 10px;font-size:11px;line-height:1.45;&quot;&gt;+ session: AgentSession&lt;br/&gt;+ extensionsResult: LoadExtensionsResult&lt;br/&gt;+ modelFallbackMessage?: string&lt;br/&gt;+ services: AgentSessionServices&lt;br/&gt;+ diagnostics: Diagnostic[]&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="90" width="460" height="200" as="geometry" />
        </mxCell>

        <mxCell id="fn" value="&lt;p style=&quot;margin:6px 0 4px 0;text-align:center;&quot;&gt;&lt;i&gt;&amp;laquo;function&amp;raquo;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;createAgentSessionRuntime()&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:8px 10px;font-size:11px;line-height:1.45;&quot;&gt;+ createAgentSessionRuntime(factory, options): Promise&amp;lt;AgentSessionRuntime&amp;gt;&lt;br/&gt;&lt;br/&gt;调用 factory，再 new AgentSessionRuntime。&lt;br/&gt;同一 factory 会留给后续替换复用。&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
