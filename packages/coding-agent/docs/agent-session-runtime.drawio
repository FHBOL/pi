          <mxGeometry x="920" y="50" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="runtimeLane" value="进程级槽位 · 会话身份会变" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="AgentSessionRuntime&#10;当前槽位：session + services&#10;替换协议：abort → session_shutdown → dispose → createRuntime → apply → rebind&#10;方法：newSession / switchSession / fork / importFromJsonl" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#ffffff;strokeColor=#d79b00;fontStyle=0;" vertex="1" parent="runtimeLane">
          <mxGeometry x="40" y="50" width="780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="factory" value="CreateAgentSessionRuntimeFactory&#10;闭包捕获 CLI 固定输入（-e / -ne / 信任策略）&#10;按目标 cwd 重建 services，再解析 model/tools&#10;createAgentSessionServices → createAgentSessionFromServices" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="runtimeLane">
          <mxGeometry x="850" y="50" width="470" height="130" as="geometry" />
        </mxCell>

        <mxCell id="services" value="AgentSessionServices · cwd 绑定基础设施（接口 + 工厂，不是 class）" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="640" height="360" as="geometry" />
        </mxCell>
