<mxfile host="drawio" version="26.0.0">
  <diagram id="agent-session-runtime" name="会话运行时分层">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="coding-agent 会话运行时分层" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1360" height="30" as="geometry" />
        </mxCell>

        <mxCell id="modes" value="模式层 · 持有 Runtime，不直接持有 AgentSession" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1360" height="120" as="geometry" />
        </mxCell>
