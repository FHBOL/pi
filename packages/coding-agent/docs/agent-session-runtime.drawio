          <mxGeometry x="40" y="150" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="modelRuntime" value="ModelRuntime&#10;auth.json + models.json（可跨 cwd 复用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="services">
          <mxGeometry x="40" y="250" width="560" height="80" as="geometry" />
