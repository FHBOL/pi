{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Extension Loading Workflow",
    "subtitle": "Resolve sources, import factories, collect capabilities, then attach them to AgentSession",
    "output": "extensions-load-workflow.html",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "viewBox": [880, 660],
    "views": [
